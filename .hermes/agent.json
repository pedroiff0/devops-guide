{
  "name": "devops-guide-agent",
  "version": "1.0.0",
  "description": "Hermes Agent configuration for the DevOps Guide & Second Brain Documentation Hub",
  "rules": [
    "AGENTS.md",
    "skills/README.md"
  ],
  "skills_path": "skills",
